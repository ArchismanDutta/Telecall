# Copy to .env and fill in. Every value here is optional; the defaults are shown.
# A real environment variable always wins over this file, so a stray .env on a
# server can never override what the platform sets.

# --- administrator account -------------------------------------------------
# Created once, the first time the server boots against an empty database.
# If ADMIN_PASSWORD is unset a random one is generated and printed to the log,
# exactly once. Changing these later does nothing — reset from the app instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- database --------------------------------------------------------------
# Unset: an embedded Postgres in .data/, for development only. It is not
# crash-safe and is wiped by a redeploy, so always set this in production.
DATABASE_URL=

# --- server ----------------------------------------------------------------
PORT=8787

# Set to "production" on a hosted deployment: it marks the session cookie Secure.
NODE_ENV=

# Only needed if the browser app is served from a different origin to the API.
# Comma-separated, no trailing slash. Leave empty when they share an origin.
ALLOWED_ORIGINS=
